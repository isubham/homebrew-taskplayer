new file mode 100644
index 0000000..116d6a4
--- /dev/null
+++ b/src-tauri/src/commands/journal.rs
@@ -0,0 +1,116 @@
+use std::path::PathBuf;
+
+use super::super::*;
+
+fn available_root(state: &AppState) -> Result<PathBuf, String> {
+    let root = state
+        .local_notes
+        .lock()
+        .unwrap()
+        .root
+        .clone()
+        .ok_or_else(|| LOCAL_NOTES_DISABLED_MSG.to_string())?;
+    if !root.is_dir() {
+        return Err(LOCAL_NOTES_UNAVAILABLE_MSG.to_string());
+    }
+    Ok(root)
